{
  "appId": "com.rusdifuniture.toko",
  "appName": "Rusdi Furniture",
  "webDir": "www",
  "server": {
    "url": "https://rusdifuniture.vercel.app/",
    "androidScheme": "https",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2200,
      "launchAutoHide": true,
      "backgroundColor": "#0B0B0B",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
